DATABASE_URL=postgresql://user:password@postgres:5432/procurement_db

JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=documents

OCR_LANGUAGE=fra+ara
OCR_PSM=3
OCR_CONFIDENCE_THRESHOLD=60
OCR_MIN_WORDS_FOR_CONFIDENCE=3
OCR_OSD_MIN_CONFIDENCE=1.0
# Windows dev machines only — winget's Tesseract install isn't on PATH and
# ships without the French pack; ocr/tesseract_engine.py auto-detects the
# common install path, these override it if needed. Not needed in Docker
# (Dockerfile installs tesseract-ocr via apt, already on PATH).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Users\<user>\AppData\Local\tessdata

MAX_FILE_SIZE_MB=20

SCRAPER_RATE_LIMIT_SECONDS=2
SCRAPER_USER_AGENT=public-procurement-intelligence-bot (academic project)

# Corpus PV (400 extraits de PV) — dans le repo, pas dans Downloads
PV_CORPUS_PATH=data/samples/PVs
PV_MANIFEST_PATH=data/samples/PVs/manifest.jsonl
