# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment
.env

# Data (généré/scrapé — pas versionné, trop volumineux et régénérable)
data/raw/
# Sorties intermediaires exclues par defaut -- on exclut le CONTENU de
# data/processed/ (avec /*) et non le dossier lui-meme, car git ne peut
# pas re-inclure un fichier dont un dossier parent est exclu.
data/processed/*
# Exception : le texte OCR est volontairement versionne. C'est l'entree
# des Issues 6 et 7, il represente ~2h de calcul, et il ne pese que
# 1,6 Mo reels (les 97 Mo vus dans l'explorateur sont de l'espace disque
# alloue, pas du contenu : NTFS arrondit chaque petit fichier).
!data/processed/ocr/

# Exception : les tables analytiques plates (scores, features, red flags)
# sont versionnees pour que le dashboard deploye (Streamlit Community
# Cloud, qui clone depuis GitHub sans jamais rejouer le pipeline
# localement) ait de vraies donnees a afficher. ~2,9 Mo, resultats
# agreges uniquement, aucun document brut ni donnee source. Les
# sous-dossiers (sorties brutes PySpark : part-*.parquet, _SUCCESS, .crc)
# restent exclus : bruit interne, non lus par le dashboard deploye.
!data/processed/analytics/
data/processed/analytics/*/

# data/samples/ et data/synthetic/ restent versionnés (petits, curés à la main)
# EXCEPTION : le corpus des 400 extraits de PV (343 Mo) est scrapé et régénérable
# via scripts/download_extraits_pv.py — seul son manifeste est versionné, car il
# porte les clés de jointure (refConsultation) et la traçabilité des sources.
data/samples/PVs/*
!data/samples/PVs/manifest.jsonl

# ML models (générés par l'entraînement, pas versionnés — même principe
# que data/processed/analytics/ : régénérable de façon deterministe via
# `python -m ai.train_isolation_forest`, random_state=42)
ai/models/*.pkl
ai/models/*.joblib
ai/models/feature_columns.json

# Exception : le modele marche (2,4 Mo), utilise en direct par le scoring
# a la volee de la page Importation du dashboard deploye. L'ancien modele
# entreprise (isolation_forest.joblib) reste exclu : obsolete depuis la
# refonte du 28/08/2026 (voir docs/refonte_marche.md).
!ai/models/isolation_forest_market.joblib
!ai/models/market_feature_columns.json

# Docker
*.log

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Documents de travail personnels, non versionnés
docs/comprendre.md
docs/onboarding.md

# Dossier de travail pour annotation manuelle (copies regenerables, ~16 Mo)
data/annotation/

# Sauvegardes horodatees avant operation destructive (pg_dump + artefacts)
backups/

# Outillage local de session
.claude/
